{
  "name": "earshot",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "The open-source, verifiable voice layer for your CRM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShreeBohara/earshot.git"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "ci:check": "biome ci .",
    "contracts:gen": "turbo run contracts:gen"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
