{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "minimumReleaseAge": "3 days",
  "schedule": ["before 6am on monday"],
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "groupName": "cloudflare",
      "matchPackageNames": ["wrangler", "@opennextjs/cloudflare", "@cloudflare/**"]
    },
    {
      "groupName": "storybook",
      "matchPackageNames": ["storybook", "@storybook/**", "@chromatic-com/storybook"]
    },
    {
      "description": "@cloudflare/vitest-pool-workers supports Vitest 4.1 only; lift when it supports 5.",
      "matchPackageNames": ["vitest", "@vitest/**"],
      "allowedVersions": "<5"
    },
    {
      "description": "TypeScript 7.0 ships no compiler API; lift when 7.1 restores it.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "description": "0.23.0 failed pnpm's trustPolicy (trust downgrade); see pnpm-workspace.yaml.",
      "matchPackageNames": ["@cloudflare/vitest-pool-workers"],
      "allowedVersions": "<0.23"
    }
  ]
}
