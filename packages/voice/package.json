{
  "name": "@earshot/voice",
  "version": "0.0.0",
  "private": true,
  "description": "The browser voice runtime: microphone capture, speech-to-text adapters, the Debrief engine, the client session runtime, the price table, and pure state machines.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./machines": "./src/machines/index.ts",
    "./prices": "./src/prices.ts",
