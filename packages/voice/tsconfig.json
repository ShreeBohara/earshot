{
  "extends": "@earshot/tsconfig/base.json",
  "compilerOptions": {
    // The browser runtime needs the DOM. `./machines` and `./prices` must not: test/no-dom.test.ts
    // typechecks them again with ES2023 alone.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["src", "test", "scripts", "vitest.config.ts"]
}
