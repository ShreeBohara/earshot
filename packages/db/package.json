{
  "name": "@earshot/db",
  "version": "0.0.0",
  "private": true,
  "description": "Earshot's Postgres schema, migrations, and client (Neon + Drizzle).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:stamp": "tsx scripts/stamp-branch.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@earshot/tsconfig": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-pgtap": "catalog:",
    "@electric-sql/pglite-pgvector": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
