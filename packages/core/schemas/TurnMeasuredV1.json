{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "turnId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "push_to_talk",
        "hands_free"
      ]
    },
    "speechEndToFinalMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "finalToProposalMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "proposalToPaintMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "turnId",
    "mode",
    "speechEndToFinalMs",
    "finalToProposalMs",
    "proposalToPaintMs",
    "totalMs"
  ],
  "additionalProperties": false,
  "title": "TurnMeasuredV1",
  "description": "Payload of `turn.measured`, schema version 1: one turn's latency, by stage, on the client's clock.",
  "x-event-type": "turn.measured",
  "x-schema-version": 1
}
