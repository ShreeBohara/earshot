{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposalId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "type": {
      "type": "string",
      "enum": [
        "note",
        "task",
        "contact",
        "deal_update",
        "commitment"
      ]
    },
    "targetEntityId": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "utteranceId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "span": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "audioMs": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "utteranceId",
              "span",
              "audioMs",
              "confidence"
            ],
            "additionalProperties": false,
            "title": "Evidence"
          }
        },
        "required": [
          "value",
          "evidence"
        ],
        "additionalProperties": false,
        "title": "ProposalField"
      }
    },
    "riskFlags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "date",
              "number",
              "negation",
              "low_confidence",
              "unsupported",
              "new_entity",
              "witness_conflict"
            ]
          },
          "field": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false,
        "title": "RiskFlag"
      }
    }
  },
  "required": [
    "proposalId",
    "type",
    "targetEntityId",
    "fields",
    "riskFlags"
  ],
  "additionalProperties": false,
  "title": "ProposalCreatedV1",
  "description": "Payload of `proposal.created`, schema version 1: a proposed CRM change with evidence for every field.",
  "x-event-type": "proposal.created",
  "x-schema-version": 1
}
