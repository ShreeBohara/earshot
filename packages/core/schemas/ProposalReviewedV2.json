{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reviewId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "proposalId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "approved",
        "edited",
        "rejected",
        "reopened"
      ]
    },
    "target": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "entityId": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "entityId"
          ],
          "additionalProperties": false,
          "title": "ReviewTarget"
        },
        {
          "type": "null"
        }
      ]
    },
    "editDiff": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "before": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "after": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "required": [
          "before",
          "after"
        ],
        "additionalProperties": false,
        "title": "FieldEdit"
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "single",
        "batch",
        "policy",
        "system"
      ]
    },
    "batchId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "rule": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "version",
            "rule"
          ],
          "additionalProperties": false,
          "title": "ReviewPolicy"
        },
        {
          "type": "null"
        }
      ]
    },
    "undoes": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "undo",
            "flagged"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "seen": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tier": {
              "type": "string",
              "enum": [
                "loud",
                "quiet",
                "none"
              ]
            },
            "fields": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "proposed": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "base": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  },
                  "current": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                },
                "required": [
                  "proposed"
                ],
                "additionalProperties": false,
                "title": "SeenField"
              }
            },
            "target": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "entityId": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "offered": {
                      "maxItems": 4,
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "entityId",
                    "offered"
                  ],
                  "additionalProperties": false,
                  "title": "SeenTarget"
                },
                {
                  "type": "null"
                }
              ]
            },
            "relinked": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "clip": {
              "type": "string",
              "enum": [
                "played",
                "available",
                "none"
              ]
            }
          },
          "required": [
            "tier",
            "fields",
            "target",
            "relinked",
            "clip"
          ],
          "additionalProperties": false,
          "title": "ReviewSeen"
        },
        {
          "type": "null"
        }
      ]
    },
    "timing": {
      "type": "object",
      "properties": {
        "decisionMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "handlingMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "decisionMs",
        "handlingMs"
      ],
      "additionalProperties": false,
      "title": "ReviewTiming"
    },
    "input": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "keyboard",
            "pointer",
            "touch",
            "voice",
            "none"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "surface": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "inbox",
            "tray",
            "pilot",
            "session"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "syncEligibleAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "by": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "userId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "auth": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "method": {
                      "type": "string",
                      "enum": [
                        "passkey",
                        "magic_link",
                        "github",
                        "google",
                        "unknown"
                      ]
                    },
                    "signedInAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    }
                  },
                  "required": [
                    "method",
                    "signedInAt"
                  ],
                  "additionalProperties": false,
                  "title": "ReviewerAuth"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "userId",
            "auth"
          ],
          "additionalProperties": false,
          "title": "Reviewer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "reviewId",
    "proposalId",
    "decision",
    "target",
    "mode",
    "batchId",
    "policy",
    "undoes",
    "reason",
    "seen",
    "timing",
    "input",
    "surface",
    "syncEligibleAt",
    "by"
  ],
  "additionalProperties": false,
  "title": "ProposalReviewedV2",
  "description": "Payload of `proposal.reviewed`, schema version 2: a decision on one proposal, the record chosen, how and by whom it was made, what the reviewer saw, and when an approval may sync. An undo is a later review that reopens the proposal.",
  "x-event-type": "proposal.reviewed",
  "x-schema-version": 2
}
