{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposalId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "source": {
      "type": "string",
      "enum": [
        "witness"
      ]
    },
    "flags": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "date",
              "number",
              "negation",
              "low_confidence",
              "unsupported",
              "new_entity",
              "witness_conflict",
              "link_uncertain",
              "ambiguous_target",
              "implied_target",
              "value_mismatch",
              "ambiguous_value",
              "self_correction",
              "weak_support"
            ]
          },
          "field": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false,
        "title": "RiskFlagV2"
      }
    },
    "target": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "decision": {
              "type": "string",
              "const": "ask"
            },
            "candidates": {
              "minItems": 1,
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "entityId": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "p": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "entityId",
                  "p"
                ],
                "additionalProperties": false,
                "title": "TargetCandidate"
              }
            }
          },
          "required": [
            "decision",
            "candidates"
          ],
          "additionalProperties": false,
          "title": "TargetDowngrade"
        },
        {
          "type": "null"
        }
      ]
    },
    "conflict": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$"
            },
            "biased": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "object",
                  "properties": {
                    "utteranceId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "span": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "audioMs": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "utteranceId",
                    "span",
                    "audioMs",
                    "confidence"
                  ],
                  "additionalProperties": false,
                  "title": "Evidence"
                }
              },
              "required": [
                "text",
                "evidence"
              ],
              "additionalProperties": false
            },
            "unbiased": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1
                    },
                    "utteranceId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "audioMs": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "required": [
                    "text",
                    "utteranceId",
                    "audioMs"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "field",
            "biased",
            "unbiased"
          ],
          "additionalProperties": false,
          "title": "WitnessConflict"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "proposalId",
    "source",
    "flags",
    "target",
    "conflict"
  ],
  "additionalProperties": false,
  "title": "ProposalFlaggedV1",
  "description": "Payload of `proposal.flagged`, schema version 1: flags added to a proposal after it appeared, such as a conflict between the two witnesses, and any downgrade of its target.",
  "x-event-type": "proposal.flagged",
  "x-schema-version": 1
}
