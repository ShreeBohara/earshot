{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposalId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "type": {
      "type": "string",
      "enum": [
        "note",
        "task",
        "contact",
        "deal_update",
        "commitment",
        "meeting"
      ]
    },
    "target": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "linked",
            "ask",
            "new",
            "none"
          ]
        },
        "entityId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "company",
                "contact",
                "deal"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "exact",
                "sound",
                "context",
                "focus"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "p": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "mention": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "object",
                  "properties": {
                    "utteranceId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "span": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "audioMs": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "utteranceId",
                    "span",
                    "audioMs",
                    "confidence"
                  ],
                  "additionalProperties": false,
                  "title": "Evidence"
                }
              },
              "required": [
                "quote",
                "evidence"
              ],
              "additionalProperties": false,
              "title": "TargetMention"
            },
            {
              "type": "null"
            }
          ]
        },
        "company": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence": {
                  "type": "object",
                  "properties": {
                    "utteranceId": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "span": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "audioMs": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        }
                      ],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "utteranceId",
                    "span",
                    "audioMs",
                    "confidence"
                  ],
                  "additionalProperties": false,
                  "title": "Evidence"
                },
                "entityId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "quote",
                "evidence",
                "entityId"
              ],
              "additionalProperties": false,
              "title": "TargetCompany"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidates": {
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entityId": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "p": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "entityId",
              "p"
            ],
            "additionalProperties": false,
            "title": "TargetCandidate"
          }
        }
      },
      "required": [
        "decision",
        "entityId",
        "kind",
        "basis",
        "p",
        "mention",
        "company",
        "candidates"
      ],
      "additionalProperties": false,
      "title": "TargetV2"
    },
    "fields": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "evidence": {
            "type": "object",
            "properties": {
              "utteranceId": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "span": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "audioMs": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "utteranceId",
              "span",
              "audioMs",
              "confidence"
            ],
            "additionalProperties": false,
            "title": "Evidence"
          },
          "norm": {
            "type": "object",
            "properties": {
              "llmValue": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              },
              "readings": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            },
            "additionalProperties": false,
            "title": "FieldNorm"
          }
        },
        "required": [
          "value",
          "evidence"
        ],
        "additionalProperties": false,
        "title": "ProposalFieldV2"
      }
    },
    "riskFlags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "date",
              "number",
              "negation",
              "low_confidence",
              "unsupported",
              "new_entity",
              "witness_conflict",
              "link_uncertain",
              "ambiguous_target",
              "implied_target",
              "value_mismatch",
              "ambiguous_value",
              "self_correction",
              "weak_support"
            ]
          },
          "field": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false,
        "title": "RiskFlagV2"
      }
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "linker": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "proposalId",
    "type",
    "target",
    "fields",
    "riskFlags",
    "supersedes",
    "linker"
  ],
  "additionalProperties": false,
  "title": "ProposalCreatedV2",
  "description": "Payload of `proposal.created`, schema version 2: a proposed CRM change whose target the entity linker resolved, with evidence for every field.",
  "x-event-type": "proposal.created",
  "x-schema-version": 2
}
