{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "proposalId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "jobId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "reviewId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "provider": {
      "type": "string",
      "enum": [
        "hubspot",
        "twenty",
        "attio",
        "demo"
      ]
    },
    "connectionId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "mapping": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "version",
            "sha256"
          ],
          "additionalProperties": false,
          "title": "SyncMappingRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "waivedWindow": {
      "type": "boolean"
    }
  },
  "required": [
    "proposalId",
    "jobId",
    "reviewId",
    "attempt",
    "provider",
    "connectionId",
    "mapping",
    "waivedWindow"
  ],
  "additionalProperties": false,
  "title": "ProposalSyncStartedV1",
  "description": "Payload of `proposal.sync_started`, schema version 1: the outbox claimed a job, the point after which nothing reopens the proposal.",
  "x-event-type": "proposal.sync_started",
  "x-schema-version": 1
}
