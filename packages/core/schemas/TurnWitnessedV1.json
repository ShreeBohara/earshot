{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "turnId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "compared",
        "failed",
        "skipped"
      ]
    },
    "provider": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "utteranceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "conflicts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latencyMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "off",
            "no_key",
            "too_long",
            "rate_limited",
            "provider_error",
            "timeout"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "turnId",
    "outcome",
    "provider",
    "model",
    "utteranceIds",
    "conflicts",
    "latencyMs",
    "reason"
  ],
  "additionalProperties": false,
  "title": "TurnWitnessedV1",
  "description": "Payload of `turn.witnessed`, schema version 1: how one turn's second witness ended.",
  "x-event-type": "turn.witnessed",
  "x-schema-version": 1
}
