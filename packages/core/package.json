{
  "name": "@earshot/core",
  "version": "0.0.0",
  "private": true,
  "description": "Earshot's shared contracts: Zod schemas, their JSON Schema exports, and parity fixtures.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schemas/*": "./schemas/*"
  },
  "scripts": {
    "contracts:gen": "tsx scripts/export-schemas.ts",
