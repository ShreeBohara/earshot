  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@earshot/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
