{
  "name": "@earshot/evals",
  "version": "0.0.0",
  "private": true,
  "description": "Eval harness v0: 30 synthetic debrief scripts with ground truth, their schema and coverage rules, the session context they run in, the renderer's timing contract, cassettes for both LLM adapters, and the fake-microphone eval's checks, report, baselines, and live budget guard.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cassettes": "./src/cassettes.ts",
    "./cassettes/*": "./cassettes/*",
    "./debriefs/*": "./debriefs/*",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "baseline:update": "tsx scripts/update-baseline.ts",
    "cassettes:gen": "tsx scripts/gen-cassettes.ts",
    "eval:budget": "tsx scripts/eval-live-budget.ts",
    "eval:report": "tsx scripts/eval-report.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@earshot/agent": "workspace:*",
    "@earshot/core": "workspace:*",
    "@earshot/demo-crm": "workspace:*",
    "@earshot/voice": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@earshot/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
