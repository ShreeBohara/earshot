{
  "name": "@earshot/evals",
  "version": "0.0.0",
  "private": true,
  "description": "Eval harness: 200 debrief scripts with ground truth (30 hand-written, 170 from a seeded grammar), their schema and coverage rules, the session context they run in, the renderer timing contract, cassettes for both LLM adapters, the fake-microphone eval checks, report, baselines, and live budget guard; the $0 understanding eval and its gate; and the confusable-name set for entity linking, its mishearing simulator, metrics, report, and linker v1's fit and ablations.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cassettes": "./src/cassettes.ts",
    "./cassettes/*": "./cassettes/*",
    "./channel": "./src/channel/index.ts",
    "./debriefs/*": "./debriefs/*",
    "./fixtures/*": "./fixtures/*",
    "./linking": "./src/linking/index.ts",
    "./linking/*": "./linking/*",
    "./understanding": "./src/understanding/index.ts"
  },
  "scripts": {
    "baseline:update": "tsx scripts/update-baseline.ts",
    "cassettes:gen": "tsx scripts/gen-cassettes.ts",
    "debriefs:gen": "tsx scripts/gen-debriefs.ts",
    "eval:budget": "tsx scripts/eval-live-budget.ts",
    "eval:linking": "tsx scripts/eval-linking.ts",
    "eval:report": "tsx scripts/eval-report.ts",
    "linker:fit": "tsx scripts/fit-linker.ts",
    "linking:gen": "tsx scripts/gen-confusable.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@earshot/agent": "workspace:*",
    "@earshot/core": "workspace:*",
    "@earshot/demo-crm": "workspace:*",
    "@earshot/understanding": "workspace:*",
    "@earshot/voice": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@earshot/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
