{
  "$description": "Earshot's motion durations and easings. Hand-written in src/dtcg.ts. Generated by `pnpm --filter @earshot/tokens theme`. Don't edit by hand.",
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    },
    "medium": {
      "$type": "duration",
      "$value": {
        "value": 180,
        "unit": "ms"
      }
    },
    "slow": {
      "$type": "duration",
      "$value": {
        "value": 240,
        "unit": "ms"
      }
    },
    "reduced": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      },
      "$description": "The cap under prefers-reduced-motion, where every animation becomes an opacity fade."
    }
  },
  "easing": {
    "standard": {
      "$type": "cubicBezier",
      "$value": [0.2, 0, 0, 1]
    },
    "exit": {
      "$type": "cubicBezier",
      "$value": [0.4, 0, 1, 1]
    }
  }
