// Template for the edge Worker. CI renders per-environment copies (wrangler.<target>.jsonc)
// with scripts/render-wrangler.ts. Deploy this Worker before the web Worker that binds to it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "earshot-edge",
  "main": "src/index.ts",
  // 2026-11-10: the newest date the test runtime (@cloudflare/vitest-plugin 1.8, workerd 1.20261110) supports; keep tests and production on the same date.
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "SESSION", "class_name": "SessionDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],
  // The flush to Postgres (docs/adr/0024). This Worker produces and consumes; render-wrangler.ts
  // names the queues per target (earshot-flush-pr-N for previews), and the preview workflow
  // creates them before deploying.
  "queues": {
    "producers": [
      { "binding": "FLUSH", "queue": "earshot-flush" },
      // The consumer sends a batch that can never succeed straight here, without retrying it.
      { "binding": "FLUSH_DLQ", "queue": "earshot-flush-dlq" }
    ],
    "consumers": [
      {
        "queue": "earshot-flush",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        // Above the default of 3: repairing a gap can take a delivery or two.
        "max_retries": 5,
        "dead_letter_queue": "earshot-flush-dlq"
      }
    ]
  },
  // WEB_ORIGIN is the session socket's Origin allow-list (comma-separated); render-wrangler.ts sets
  // each target's web origin. Secrets live outside this file (env.d.ts, .dev.vars.example):
  // EARSHOT_SESSION_TICKET_SECRET and DATABASE_URL. Optional: AI_GATEWAY_ACCOUNT_ID, AI_GATEWAY_ID.
  "vars": { "WEB_ORIGIN": "http://localhost:3000", "DEPLOY_ENV": "development", "GIT_SHA": "dev" },
  "observability": { "enabled": true }
}
