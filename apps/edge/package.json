{
  "name": "@earshot/edge",
  "version": "0.0.0",
  "private": true,
  "description": "Hono Worker that owns Earshot's Durable Objects (one SessionDO per session).",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:e2e": "wrangler dev src/e2e.ts",
    "build": "wrangler deploy --dry-run --outdir dist && node scripts/check-bundle.mjs",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@earshot/agent": "workspace:*",
    "@earshot/core": "workspace:*",
    "@earshot/db": "workspace:*",
    "@earshot/events": "workspace:*",
    "@earshot/keys": "workspace:*",
    "@earshot/voice": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "catalog:",
    "@earshot/evals": "workspace:*",
    "@earshot/tsconfig": "workspace:*",
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-pgvector": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
