# Copy to .dev.vars for local development. Never commit .dev.vars. Placeholders only below.
#
# Zero-setup mode: with every optional line commented out, `pnpm dev` runs against an in-process
# PGlite database in apps/web/.data/, prints magic links to the server console, and uses a
# development-only auth secret. Uncomment lines to use real services instead.

# Database. The pooled connection string of your personal Neon branch (dev/<you>).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Where `next dev` reaches the edge Worker if the service binding isn't available.
EDGE_DEV_URL=http://localhost:8787

# Session tickets and the session socket (docs/adr/0023). Without them, `next dev` signs tickets
# with a development-only secret, which the edge Worker's `wrangler dev` falls back to as well,
# and sends the browser to EDGE_DEV_URL. Both are required outside `next dev`, for example by
# `pnpm preview`, which serves this Worker on port 8787: run the edge Worker on another port
# (`wrangler dev --port 8788`) and give it the same secret (`openssl rand -base64 32`).
# EARSHOT_SESSION_TICKET_SECRET=replace-with-at-least-32-random-bytes
# EDGE_PUBLIC_URL=http://localhost:8788

# Auth. Required outside `next dev`, for example by `pnpm preview`, which runs the production
# build in workerd. Generate the secret with `openssl rand -base64 32`.
# BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_TRUSTED_ORIGINS=https://another-origin.example

# OAuth sign-in. Each provider shows up only when both of its values are set.
# Callback URLs: <BETTER_AUTH_URL>/api/auth/callback/github and .../callback/google
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# GOOGLE_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Magic-link email through Resend. Without both, dev prints links to the console instead.
# RESEND_API_KEY=re_your_resend_api_key
# EMAIL_FROM=Earshot <sign-in@mail.example.com>

# The optional server vault (off when unset). 32 random bytes, base64-encoded; generate one with
#   pnpm --filter @earshot/keys exec node --input-type=module -e "import('./src/vault.ts').then(m => console.log(m.generateMasterKey()))"
# or `openssl rand -base64 32`. Keep it with your other secrets: rows sealed with it don't open
# without it, and changing it needs the rotation runbook (docs/vault-key-rotation.md).
# EARSHOT_VAULT_MASTER_KEY=replace-with-32-random-bytes-base64

# Audit checkpoints (docs/adr/0033). Without a key, `next dev` signs with the committed development
# key, which every other environment refuses. Outside `next dev`, set a private Ed25519 JWK from
# `pnpm --filter @earshot/keys audit-key:new` (the same value on the edge Worker); without one,
# writes that need a checkpoint fail closed. Retired keys are public JWKs, as a JSON array.
# EARSHOT_AUDIT_SIGNING_KEY={"kty":"OKP","crv":"Ed25519","d":"…","x":"…","kid":"audit-YYYY-MM-DD-xxxx"}
# EARSHOT_AUDIT_RETIRED_KEYS=[{"kty":"OKP","crv":"Ed25519","x":"…","kid":"…","retiredAt":"2026-12-01T09:00:00Z"}]
